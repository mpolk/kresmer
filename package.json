{
  "name": "kresmer-meta",
  "private": true,
  "version": "0.19.5",
  "author": "Dmitriy Stepanenko <mpolk@sns.net.ua>",
  "description": "\"Kreslennya Merezh\" - network diagram editor and viewer: the standalone editor",
  "homepage": "https://github.com/mpolk/kresmer",
  "scripts": {
    "component:build": "npm run vite:build -w kresmer",
    "app:dev": "npm run app:dev -w e-kresmer",
    "app:preview": "npm run app:preview -w e-kresmer",
    "app:build": "npm run app:build -w e-kresmer",
    "test": "npm run test -w kresmer",
    "cypress:run": "npm run cypress:run -w kresmer",
    "cypress:open": "npm run cypress:open -w kresmer",
    "cypress:debug": "npm run cypress:debug -w kresmer",
    "i18n": "npm run i18n -w e-kresmer",
    "lint-all": "pnpm run -r --no-bail lint",
    "lint": "echo There is nothing to lint in the root directory. Run lint-all instead",
    "typedoc": "typedoc --tsconfig packages/core-component/tsconfig.json packages/core-component/src/Kresmer.ts"
  },
  "workspaces": [
    "./packages/*"
  ],
  "devDependencies": {
    "typedoc": "^0.28.20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true,
    "cypress@15.20.0": true
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
