{
  "name": "e-kresmer",
  "desktopName": "kresmer",
  "private": true,
  "version": "0.19.1",
  "author": "Dmitriy Stepanenko <mpolk@sns.net.ua>",
  "description": "\"Kreslennya Merezh\" - network diagram editor and viewer: the standalone editor",
  "main": "dist/main/main.js",
  "config": {
    "port": 5173,
    "args": ""
  },
  "scripts": {
    "build-only": "vite build",
    "build-component": "npm run vite:build -w kresmer",
    "type-check": "vue-tsc --noEmit",
    "vite:dev": "vite --port ${npm_package_config_port}",
    "vite:build": "run-p type-check build-only",
    "vite:preview": "vite preview --port ${npm_package_config_port}",
    "ts": "tsc",
    "watch": "tsc -w",
    "lint": "eslint ./src",
    "preapp:dev0": "run-s build-component ts",
    "app:dev0": "concurrently vite 'electron . ${npm_package_config_args}' npm:watch",
    "preapp:dev": "run-s build-component ts",
    "app:dev": "concurrently 'npm:build-watch -w kresmer' vite 'electron --remote-debugging-port=9223 . -- ${npm_package_config_args}' npm:watch",
    "preapp:build": "run-s build-component vite:build ts",
    "app:build": "electron-builder -lw",
    "preapp:preview": "run-s build-component vite:build ts",
    "app:preview": "electron . -- ${npm_package_config_args}",
    "test": "npm run test -w kresmer",
    "cypress:run": "npm run cypress:run -w kresmer",
    "cypress:open": "npm run cypress:open -w kresmer",
    "cypress:debug": "npm run cypress:debug -w kresmer",
    "typedoc": "typedoc --tsconfig packages/kresmer/tsconfig.json packages/kresmer/src/Kresmer.ts",
    "i18n": "i18next -c i18next-parser.main.config.mjs && i18next -c i18next-parser.renderer.config.mjs",
    "version:minor": "npm version minor --workspaces --include-workspace-root",
    "postversion:minor": "export TAG=$(git tag --sort=v:refname | tail -1) && git commit -a --amend -m $TAG && git tag -f $TAG",
    "version:patch": "npm version patch --workspaces --include-workspace-root",
    "postversion:patch": "export TAG=$(git tag --sort=v:refname | tail -1) && git commit -a --amend -m $TAG && git tag -f $TAG"
  },
  "build": {
    "extraMetadata": {
      "name": "kresmer"
    },
    "appId": "x-kresmer",
    "productName": "Kresmer",
    "fileAssociations": [
      {
        "ext": "kre",
        "name": "Kresmer drawing",
        "role": "Editor",
        "mimeType": "application/x-kresmer-drawing",
        "icon": "logo.png"
      },
      {
        "ext": "krel",
        "name": "Kresmer library",
        "role": "None",
        "mimeType": "application/x-kresmer-library",
        "icon": "logo.png"
      }
    ],
    "asar": true,
    "directories": {
      "buildResources": "src/assets",
      "output": "release/${version}"
    },
    "files": [
      "dist"
    ],
    "extraFiles": [
      {
        "from": "lib",
        "to": "lib"
      },
      {
        "from": "xsd",
        "to": "xsd"
      },
      {
        "from": "locales",
        "to": "locales"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "logo.png",
      "category": "Graphics; Engineering",
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.2.3",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.3",
    "i18next-fs-backend": "^2.3.1",
    "kresmer": "^0.0.0",
    "postcss": "^8.4.41",
    "uuid": "^14.0.1",
    "vue": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.1.0",
    "@types/bootstrap": "^5.2.6",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.4.0",
    "i18next-parser": "^9.4.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.54.3",
    "start-server-and-test": "^3.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-i18next-loader": "^4.1.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  },
  "overrides": {
    "minimatch": ">=10.2.4"
  },
  "workspaces": [
    "./packages/kresmer"
  ],
  "pnpm": {
    "overrides": {
      "braces@<2.3.1": ">=2.3.1",
      "glob-parent@<5.1.2": ">=5.1.2",
      "tough-cookie@<4.1.3": ">=4.1.3"
    }
  },
  "allowScripts": {
    "cypress@15.19.0": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
