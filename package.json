{
  "name": "kresmer-meta",
  "private": true,
  "version": "0.19.7",
  "author": "Dmitriy Stepanenko <mpolk@sns.net.ua>",
  "description": "\"Kreslennya Merezh\" - network diagram editor and viewer: the standalone editor",
  "homepage": "https://github.com/mpolk/kresmer",
  "scripts": {
    "component:build": "pnpm -C packages/core-component run vite:build",
    "component:lint": "pnpm -C packages/core-component run lint",
    "app:dev": "pnpm -C packages/electron-app run app:dev",
    "app:preview": "pnpm -C packages/electron-app run app:preview",
    "app:build": "pnpm -C packages/electron-app run app:build",
    "app:lint": "pnpm -C packages/electron-app run lint",
    "brext:chrome": "pnpm -C packages/browser-extension run build:chrome",
    "brext:firefox": "pnpm -C packages/browser-extension run build:firefox",
    "brext:build": "pnpm -C packages/browser-extension run build",
    "brext:lint": "pnpm -C packages/browser-extension run lint",
    "test": "pnpm -C packages/core-component run test",
    "cypress:run": "pnpm -C packages/core-component run cypress:run",
    "cypress:open": "pnpm -C packages/core-component run cypress:open",
    "cypress:debug": "pnpm -C packages/core-component run cypress:debug",
    "i18n": "pnpm -C packages/electron-app run i18n",
    "lint-all": "pnpm run -r --no-bail lint",
    "lint": "echo There is nothing to lint in the root directory. Run lint-all instead",
    "typedoc": "typedoc --tsconfig packages/core-component/tsconfig.json packages/core-component/src/Kresmer.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "typedoc": "^0.28.20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true,
    "cypress@15.20.0": true
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
