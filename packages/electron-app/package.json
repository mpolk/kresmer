{
  "name": "e-kresmer",
  "desktopName": "kresmer",
  "private": true,
  "version": "0.19.7",
  "author": "Dmitriy Stepanenko <mpolk@sns.net.ua>",
  "description": "\"Kreslennya Merezh\" - network diagram editor and viewer: the standalone editor",
  "homepage": "https://github.com/mpolk/kresmer",
  "main": "dist/main/main.js",
  "config": {
    "port": 5173,
    "args": ""
  },
  "scripts": {
    "build-only": "vite build",
    "component:build": "pnpm -C ../core-component run vite:build",
    "type-check": "vue-tsc --noEmit",
    "vite:dev": "vite --port ${npm_package_config_port}",
    "vite:build": "pnpm type-check && pnpm build-only",
    "vite:preview": "vite preview --port ${npm_package_config_port}",
    "ts": "tsc",
    "watch": "tsc -w",
    "lint": "eslint ./src",
    "_predev": "pnpm component:build && pnpm ts",
    "preapp:dev0": "pnpm _predev",
    "app:dev0": "concurrently vite 'electron . ${npm_package_config_args}' 'pnpm watch'",
    "preapp:dev": "pnpm _predev",
    "app:dev": "concurrently 'pnpm -C ../core-component build-watch' vite 'electron --remote-debugging-port=9223 . -- ${npm_package_config_args}' 'pnpm watch'",
    "_prebuild": "pnpm component:build && pnpm vite:build && pnpm ts",
    "preapp:build": "pnpm _prebuild",
    "app:build": "electron-builder -lw",
    "preapp:preview": "pnpm _prebuild",
    "app:preview": "electron . -- ${npm_package_config_args}",
    "i18n": "i18next-cli extract -c i18next.main.config.ts && i18next -c i18next-parser.renderer.config.mjs",
    "version:minor": "npm version minor --workspaces --include-workspace-root",
    "postversion:minor": "export TAG=$(git tag --sort=v:refname | tail -1) && git commit -a --amend -m $TAG && git tag -f $TAG",
    "version:patch": "npm version patch --workspaces --include-workspace-root",
    "postversion:patch": "export TAG=$(git tag --sort=v:refname | tail -1) && git commit -a --amend -m $TAG && git tag -f $TAG"
  },
  "build": {
    "extraMetadata": {
      "name": "kresmer"
    },
    "appId": "x-kresmer",
    "productName": "Kresmer",
    "fileAssociations": [
      {
        "ext": "kre",
        "name": "Kresmer drawing",
        "role": "Editor",
        "mimeType": "application/x-kresmer-drawing",
        "icon": "logo.png"
      },
      {
        "ext": "krel",
        "name": "Kresmer library",
        "role": "None",
        "mimeType": "application/x-kresmer-library",
        "icon": "logo.png"
      }
    ],
    "asar": true,
    "directories": {
      "buildResources": "src/assets",
      "output": "release/${version}"
    },
    "files": [
      "dist"
    ],
    "extraFiles": [
      {
        "from": "lib",
        "to": "lib"
      },
      {
        "from": "xsd",
        "to": "xsd"
      },
      {
        "from": "locales",
        "to": "locales"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "logo.png",
      "category": "Graphics; Engineering",
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.7",
    "i18next-fs-backend": "^2.6.9",
    "kresmer": "workspace:*",
    "postcss": "^8.5.31",
    "uuid": "^14.0.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "i18next-cli": "^1.80.0",
    "i18next-cli-vue": "^1.0.4",
    "i18next-parser": "^9.4.0",
    "sass": "^1.106.1",
    "start-server-and-test": "^3.0.13",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-i18next-loader": "^4.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
