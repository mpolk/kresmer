{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "Firefox (Launch)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "firefox",
            "request": "attach",
            "name": "Firefox (Attach)"
        },
        {
        "name": "Debug Main Process",
        "type": "node",
        "request": "launch", 
        "cwd": "${workspaceFolder}",
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
        "windows": {
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
        },
        "args": ["."],
        "outputCapture": "std"
        },
        {
        "type": "chrome",
        "request": "attach",
        "name": "Attach to Cypress Chrome",
        "port": 9222,
        "urlFilter": "http://localhost*",
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true,
        "resolveSourceMapLocations": [
            "${workspaceFolder}/**",
            "!**/__cypress/**",
            "!**/node_modules/**"
        ],
        "sourceMapPathOverrides": {
            "http://localhost:5173/__cypress/src/src/*": "${workspaceFolder}/packages/kresmer/src/*",
        },
        "skipFiles": [
            "**/__cypress/**",
            "**/node_modules/**"
            ]
        }
    ]
}
